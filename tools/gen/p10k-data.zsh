#!/usr/bin/env zsh
# tools/gen/p10k-data.zsh P10K_DIR OUT
# Build-time generator: runs Powerlevel10k's own code (icons.zsh, the colour table
# in p10k.zsh) and writes the results as bash data, so the bash port uses exactly
# p10k's values. zsh is needed only here, never by users.
emulate -L zsh
local p10k=${1:?P10K_DIR} out=${2:?OUT}
local version=$(cd $p10k && git describe --tags 2>/dev/null)

typeset -gA icons
source $p10k/internal/icons.zsh || exit 1

# The help texts of the p10k command (__p9k_p10k_*_usage): each is a typeset
# of a double-quoted string that may span lines; evaluate the blocks.
eval "$(awk '/^typeset -gr __p9k_p10k_[a-z_]*usage="/ {on=1} on {print} on && /"$/ && !/\\"$/ {on=0}' $p10k/internal/p10k.zsh)"

# The colour table: copy the typeset -grA __p9k_colors=( ... ) block and source it.
eval "$(sed -n '/^typeset -grA __p9k_colors=(/,/^)/p' $p10k/internal/p10k.zsh)"

{
  print -r -- "# lib/p10k/data.bash - generated by tools/gen/p10k-data.zsh from Powerlevel10k $version."
  print -r -- "# Do not edit: regenerate instead. Icons per mode (escapes expanded); colour names."
  print -r -- ''
  print -r -- 'declare -gA _p9k_colors=('
  local k
  for k in ${(ko)__p9k_colors}; do print -r -- "  [$k]=$__p9k_colors[$k]"; done
  print -r -- ')'
  print -r -- "_p9k_zsh_signals=(${(j: :)signals})"
  print -r -- ''
  print -r -- '# Help texts of the p10k command (zsh prompt escapes, printed with _p9k_pe).'
  local u
  for u in ${(ko)parameters[(I)__p9k_p10k_*usage]}; do
    # ${(qqqq)} writes ! as \! (for zsh); bash's $'...' would keep the backslash
    print -r -- "_p9k${u#__p9k}=${${(qqqq)${(P)u}}//\\!/!}"
  done
  print -r -- ''
  print -r -- '# _p9k_icons_load MODE LEGACY_ICON_SPACING -> fills the associative array icons'
  print -r -- '_p9k_icons_load() {'
  print -r -- '  declare -gA icons=()'
  print -r -- '  case "$1/$2" in'
  local mode legacy v
  for mode in flat awesome-patched awesome-fontconfig awesome-mapped-fontconfig nerdfont-v3 \
              nerdfont-complete nerdfont-fontconfig ascii powerline compatible; do
    for legacy in false true; do
      unset _p9k__icon_mode
      POWERLEVEL9K_MODE=$mode POWERLEVEL9K_LEGACY_ICON_SPACING=$legacy POWERLEVEL9K_ICON_PADDING=moderate
      icons=()
      _p9k_init_icons >/dev/null 2>&1   # awesome-mapped warns without its font mappings
      print -r -- "    $mode/$legacy) icons=("
      for k in ${(ko)icons}; do
        v=${(g::)icons[$k]}
        print -r -- "      [$k]=${${(qqqq)v}//\\!/!}"   # see the note on (qqqq) above
      done
      print -r -- '    ) ;;'
    done
  done
  # Unknown or empty mode: p10k's default branch (powerline).
  print -r -- '    *) _p9k_icons_load powerline "$2" ;;'
  print -r -- '  esac'
  print -r -- '}'
} >$out
